<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="860"
        x:Class="QuestParser.Desktop.MainWindow"
        Title="EQ2Emu QuestParser"
        Width="1280"
        Height="860"
        MinWidth="860"
        MinHeight="560"
        FontFamily="Inter, Segoe UI, sans-serif"
        FontSize="13"
        Background="#EEF2F7">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12" RowSpacing="10">
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Name="SettingsMenuItem" Header="_Settings..." />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Name="LayoutSettingsMenuItem" Header="_Layout and visibility..." />
            </MenuItem>
        </Menu>

        <GroupBox Grid.Row="1" Name="QuestSourceGroup" Header="Quest Source" Padding="12">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <Grid MinWidth="980" ColumnDefinitions="90,2*,64,*,96,2*,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="8">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Quest name" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Name="QuestNameBox" PlaceholderText="e.g. gnoll_slayer" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Author" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="3" Name="AuthorBox" />

                <CheckBox Grid.Row="0" Grid.Column="6" Name="OverwriteBox" Content="Overwrite files" VerticalAlignment="Center" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Template" VerticalAlignment="Center" />
                <ComboBox Grid.Row="1" Grid.Column="1" Name="TemplateBox" />
                <Button Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Name="NewTemplateButton" Content="New Template" HorizontalAlignment="Left" MinWidth="124" />

                <TextBlock Grid.Row="1" Grid.Column="4" Text="Spec path" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="5" Name="SpecPathBox" PlaceholderText="Generated or existing quest spec path" />
                <StackPanel Grid.Row="1" Grid.Column="6" Orientation="Horizontal" Spacing="8">
                    <Button Name="PreviewSpecButton" Content="Preview Spec" MinWidth="108" />
                    <Button Name="FetchButton" Classes="primary" Content="Fetch + Resolve" MinWidth="126" />
                </StackPanel>

                <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Name="SettingsSummaryStrip" Classes="status-strip">
                    <TextBlock Name="SettingsSummaryText"
                               Foreground="#334155"
                               TextWrapping="Wrap" />
                </Border>

                <Border Grid.Row="2" Grid.Column="4" Grid.ColumnSpan="3" Classes="status-strip">
                    <TextBlock Name="DbConfigText"
                               Foreground="#334155"
                               TextWrapping="Wrap"
                               Text="MariaDB is optional. Without DB configuration, unresolved references remain as review TODOs." />
                </Border>
            </Grid>
            </ScrollViewer>
        </GroupBox>

        <Grid Grid.Row="2" Name="WorkGrid" ColumnDefinitions="320,8,*">
            <GroupBox Grid.Column="0" Name="VerificationGroup" Header="Verification Steps" Padding="8">
                <ListBox Name="SectionList" />
            </GroupBox>

            <GridSplitter Grid.Column="1"
                          Name="VerificationSplitter"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="#64748B"
                          ToolTip.Tip="Drag to resize verification steps" />

            <TabControl Grid.Column="2" Name="MainTabs">
                <TabItem Header="Review">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <Grid Name="ReviewLayout" MinWidth="620" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" Margin="8">
                        <Border Grid.Row="0" Classes="section-banner" Padding="12">
                            <StackPanel>
                                <TextBlock Name="SectionTitleText" FontWeight="SemiBold" />
                                <TextBlock Name="SectionHelpText" Foreground="#334155" TextWrapping="Wrap" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <GroupBox Grid.Row="1" Name="SourceDataGroup" Header="Quest Source and DB Data Used by This Section" Padding="8" MinHeight="90">
                            <ListBox Name="SourceList" Classes="mono-list" />
                        </GroupBox>

                        <GroupBox Grid.Row="2" Name="EditorGroup" Header="Editable Quest Spec Values" Padding="8" MinHeight="120">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <StackPanel Name="EditorHost" Spacing="6" />
                            </ScrollViewer>
                        </GroupBox>

                        <TabControl Grid.Row="3" Name="SectionDetailsTabs" MinHeight="140">
                            <TabItem Header="DB Candidates">
                                <Grid RowDefinitions="*,Auto" Margin="8" RowSpacing="8">
                                    <ListBox Grid.Row="0" Name="CandidateList" Classes="mono-list" />
                                    <Button Grid.Row="1" Name="UseCandidateButton" Content="Use Selected Candidate" HorizontalAlignment="Right" MinWidth="168" />
                                </Grid>
                            </TabItem>
                            <TabItem Header="Current Lua">
                                <TextBox Name="SectionLuaBox"
                                         Classes="mono-box"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="NoWrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                            </TabItem>
                            <TabItem Header="Missing Spawn Wizard">
                                <TextBox Name="MissingSpawnBox"
                                         Classes="mono-box"
                                         IsReadOnly="True"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </TabItem>
                        </TabControl>
                    </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Generated / Raw Data">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <TabControl Name="GeneratedTabs" MinWidth="620" MinHeight="360" Margin="8">
                        <TabItem Header="Diagnostics">
                            <Grid RowDefinitions="*,Auto" Margin="8" RowSpacing="8">
                                <ListBox Grid.Row="0" Name="DiagnosticsList" Classes="mono-list" />
                                <CheckBox Grid.Row="1" Name="AcknowledgeDiagnosticsBox" Content="Acknowledge blockers and allow generation" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="Lua Preview">
                            <TextBox Name="LuaPreviewBox" Classes="mono-box" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="Spawn Starter">
                            <TextBox Name="SpawnScriptPreviewBox" Classes="mono-box" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="SQL Preview">
                            <TextBox Name="SqlPreviewBox" Classes="mono-box" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="Missing Report">
                            <TextBox Name="MissingPreviewBox" Classes="mono-box" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="Spec JSON">
                            <TextBox Name="SpecPreviewBox" Classes="mono-box" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="Quest Source JSON">
                            <TextBox Name="CensusQuestBox" Classes="mono-box" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                        <TabItem Header="Questgiver Source JSON">
                            <TextBox Name="CensusGiverBox" Classes="mono-box" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                        </TabItem>
                    </TabControl>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Log">
                    <TextBox Name="LogBox"
                             Classes="mono-box"
                             Margin="8"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                </TabItem>
            </TabControl>
        </Grid>

        <GroupBox Grid.Row="3" Name="ProgressGroup" Header="Progress" Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Name="StatusText" Text="Ready" FontWeight="SemiBold" />
                    <TextBlock Name="ProgressText" Foreground="#334155" Text="Load or create a quest, then verify each section before generation." TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="PreviousButton" Content="Previous" MinWidth="92" />
                    <Button Name="ResolveSectionButton" Content="Resolve Section" MinWidth="128" />
                    <Button Name="VerifyButton" Content="Verify Section" MinWidth="128" />
                    <Button Name="NextButton" Content="Next" MinWidth="92" />
                    <Button Name="GenerateButton" Classes="primary" Content="Generate Files" MinWidth="132" />
                </StackPanel>
                </ScrollViewer>
            </Grid>
        </GroupBox>
    </Grid>
</Window>
