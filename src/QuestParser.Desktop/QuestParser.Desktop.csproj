<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>eq2emu-questparser</AssemblyName>
    <Product>EQ2Emu QuestParser</Product>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <Target Name="RemoveReleasePublishSymbols" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release' and '$(RuntimeIdentifier)' != ''">
    <ItemGroup>
      <ReleasePublishSymbols Include="$(PublishDir)**\*.pdb" />
      <ReleasePublishSymbols Include="$(PublishDir)**\*.dbg" />
      <ReleasePublishSymbolDirectories Include="$(PublishDir)**\*.dSYM" />
    </ItemGroup>
    <Delete Files="@(ReleasePublishSymbols)" />
    <RemoveDir Directories="@(ReleasePublishSymbolDirectories)" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\QuestParser.Core\QuestParser.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.3" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64' or '$(RuntimeIdentifier)' == 'linux-arm64'">
    <None Include="..\..\packaging\linux\README-linux.txt" Link="README-linux.txt" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <None Include="..\..\packaging\linux\eq2emu-questparser.desktop" Link="eq2emu-questparser.desktop" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <None Include="..\..\packaging\linux\install-desktop-launcher.sh" Link="install-desktop-launcher.sh" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
    <None Include="..\..\packaging\linux\run-eq2emu-questparser.sh" Link="run-eq2emu-questparser.sh" CopyToPublishDirectory="Always" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
