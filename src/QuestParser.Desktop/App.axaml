<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QuestParser.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Window">
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style Selector="Menu">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style Selector="GroupBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#94A3B8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#0F172A" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#64748B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,5" />
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#64748B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Button">
            <Setter Property="Background" Value="#E2E8F0" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#64748B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,5" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#0F62FE" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#0847B9" />
        </Style>
        <Style Selector="TabControl">
            <Setter Property="Background" Value="#FFFFFF" />
        </Style>
        <Style Selector="TabItem">
            <Setter Property="Foreground" Value="#475569" />
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Border.status-strip">
            <Setter Property="Background" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#CBD5E1" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Border.section-banner">
            <Setter Property="Background" Value="#EAF2FF" />
            <Setter Property="BorderBrush" Value="#7BA7E8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TextBox.mono-box">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
        </Style>
        <Style Selector="ListBox.mono-list">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Menlo, monospace" />
        </Style>
    </Application.Styles>
</Application>
